{
    "providers": ["php", "node"],
    "phases": {
        "setup": {
            "nixPkgs": [
                "php82",
                "php82Extensions.pdo_mysql",
                "php82Extensions.mbstring",
                "composer",
                "nodejs_18"
            ]
        },
        "install": {
            "cmds": [
                "composer install --no-dev --optimize-autoloader",
                "npm ci || npm install"
            ]
        },
        "build": {
            "cmds": ["npm run build"]
        }
    },
    "start": {
        "cmd": "php artisan serve --host=0.0.0.0 --port=$PORT"
    }
}
